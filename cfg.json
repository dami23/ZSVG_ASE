{
    "ds_to_use": "vg_3ub",
    "bs": 32,
    "nw": 4,
    "bsv": 16,
    "nwv": 4,
    "lr": 1e-4,
    "devices": 1,
    "opt_fn": "Adam",
    "opt_fn_params": {
	"betas": [0.9, 0.99]
    },
    "do_norm": false,
    "use_same_atb": true,
    "mdl_to_use": "clip",
    "resize_img": [384, 384],
    "tmp_path": "./tmp",
    "use_multi": true,
    "use_focal": true,
    "use_softmax": false,
    "alpha": 0.5,
    "gamma": 2.0,
    "ratios": "[1/2, 1, 2]",
    "scales": "[1, 2**(1/3), 2**(2/3)]",
    "scale_factor": 4,
    "emb_dim": 300,
    "matching_threshold": 0.5,
    "epochs": 10,
    "use_bidirectional": true,
    "lstm_dim": 128,
    "use_reduce_lr_plateau": true,
    "patience": 2,
    "reduce_factor": 0.1,
    "lamb_reg": 1,
    "resume_path": "",
    "resume": false,
    "load_opt": false,
    "strict_load": true,
    "load_normally": true,
    "acc_iou_threshold": 0.3,
    "use_lang": true,
    "use_img": true,
    "text_context": true,
    "vis_context": true,
    "model_dim": 256,
    "ffn_dim": 2048,
    "n_head": 8,
    "n_layer": 1,
    "transformer_dropout": 0.1,
    "fusion_adaptive": true,
    "aggregate_adaptive": true,
    "adaptive_focal": true,
    "adaptive_mode": "add",
    "weight": 0.5,
    "model_name": "lang_specificity_reinforce",
    "specificity_loss_weight": 0.1,
    "specificity_num_clusters": 8,
    "specificity_text_temperature": 0.07,
    "specificity_cluster_temperature": 0.2,
    "specificity_map_temperature": 0.07,
    "specificity_use_prototype_inheritance": false,
    "specificity_num_prototypes": 8,
    "specificity_prototype_momentum": 0.9996,
    "specificity_prototype_temperature": 0.03,
    "specificity_sinkhorn_iterations": 3,
    "specificity_prototype_loss_weight": 0.0
}
